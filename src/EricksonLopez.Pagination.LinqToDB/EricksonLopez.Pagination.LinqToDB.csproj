<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>LinqToDB async offset and keyset cursor pagination extensions for EricksonLopez.Pagination.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>pagination;linq2db;linqtodb;cursor;offset</PackageTags>
    <AssemblyName>EricksonLopez.Pagination.LinqToDB</AssemblyName>
    <RootNamespace>EricksonLopez.Pagination.LinqToDB</RootNamespace>
    <PackageId>EricksonLopez.Pagination.LinqToDB</PackageId>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Pagination\EricksonLopez.Pagination.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="linq2db" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Pagination.LinqToDB.Tests" />
  </ItemGroup>

</Project>

