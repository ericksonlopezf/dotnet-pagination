<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Packaging Properties -->
    <IsPackable>true</IsPackable>
    <Title>EricksonLopez.Pagination.Dapper</Title>
    <Description>Dapper integration for EricksonLopez.Pagination. Provides offset and keyset pagination extension methods for IDbConnection.</Description>
    <PackageTags>pagination;dapper;keyset;offset</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper.StrongName" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Pagination.Abstractions\EricksonLopez.Pagination.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.Pagination\EricksonLopez.Pagination.csproj" />
  </ItemGroup>

</Project>

