<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Pagination\EricksonLopez.Pagination.csproj" />
  </ItemGroup>

  

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);IL3050;IL2026;IL2091;S1905;CS1061</NoWarn>
    <DisablePackageValidationBaseline>true</DisablePackageValidationBaseline>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.Pagination.MongoDB</PackageId>
    <Description>MongoDB Driver offset and cursor pagination extensions for the EricksonLopez.Pagination ecosystem.</Description>
    <PackageTags>pagination;mongodb;cursor;offset</PackageTags>
  </PropertyGroup>

</Project>



