<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>Entity Framework Core async offset and keyset cursor pagination extensions for EricksonLopez.Pagination.</Description>
    <IsPackable>true</IsPackable>
    <PackageTags>pagination;entity-framework-core;efcore;cursor;offset</PackageTags>
    <AssemblyName>EricksonLopez.Pagination.EntityFrameworkCore</AssemblyName>
    <RootNamespace>EricksonLopez.Pagination.EntityFrameworkCore</RootNamespace>
    <PackageId>EricksonLopez.Pagination.EntityFrameworkCore</PackageId>
    <!--
      NOTE: IsAotCompatible is intentionally NOT set to true.
      ExpressionCache.GetOrCompile uses Expression.Compile() which emits IL at runtime
      and is incompatible with Native AOT. Consumers requiring AOT must use Dapper with
      manually-written SQL, or pre-compile their cursor key selectors at startup.
    -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Pagination\EricksonLopez.Pagination.csproj" />
  </ItemGroup>

  

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Pagination.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="EricksonLopez.Pagination.Benchmarks" />
  </ItemGroup>

</Project>

